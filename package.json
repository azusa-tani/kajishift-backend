{
  "name": "kajishift-backend",
  "version": "1.0.0",
  "description": "KAJISHIFT バックエンドAPI",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test:api": "node tests/test-api.js",
    "test:socket": "node tests/test-socket.js",
    "test:stripe-beta": "node tests/test-stripe-beta.js",
    "test:ops-guard": "node tests/test-ops-guard.js",
    "test:ops-write-guards": "node tests/test-ops-write-guards.js",
    "test:payment-reconciliation": "node tests/test-payment-reconciliation.js",
    "test:ai-worker-test-review": "node tests/test-ai-worker-test-review.js",
    "test:worker-test-submission-flow": "node tests/test-worker-test-submission-flow.js",
    "ops:monitor": "node -e \"require('./src/jobs/opsMonitorJob').runOpsMonitorOnce().then((r)=>{console.log(JSON.stringify(r,null,2));process.exit(0)}).catch((e)=>{console.error(e);process.exit(1)})\"",
    "backup:database": "node scripts/backup-database.js",
    "backup:restore-drill": "node scripts/restore-drill.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "db:setup": "npm run prisma:generate && npm run prisma:migrate",
    "seed": "node prisma/seed.js",
    "postinstall": "prisma generate",
    "build": "prisma generate"
  },
  "keywords": [
    "kajishift",
    "api",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.7.1",
